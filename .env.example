POSTGRES_PASSWORD=change-me

# Secret partagé entre le front (iPad / .exe) et l'API. Génère-en un : openssl rand -hex 24
APP_TOKEN=change-me-too

# Clé créée dans Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
# Vérifie les noms exacts avec : python scripts/test_gemini.py --list
GEMINI_MODEL=gemini-pro-latest
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_GROUNDING=false

# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGINS=http://192.168.1.50:3000
